// Copy to ~/.claude/settings.json — strip these comments, the file must be
// strict JSON.
//
// LAYERING: this file holds CONFIG, never prose. If you catch yourself wanting
// to explain a value here, the explanation belongs in ~/.claude/CLAUDE.md and
// the value belongs here — not both.
//
// The entire "hooks" block and "statusLine" are written and maintained by the
// GSD installer. Do not hand-edit them: `/gsd-update` rewrites the block, and a
// hand-edit either gets discarded or leaves a duplicate entry that fires twice
// on every tool call. If a hook is wrong, reinstall GSD.
//
// Paths below are shown for a Windows machine with fnm-managed Node. On macOS
// or Linux the node path is usually just "node" and the hook paths use $HOME.
{
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL": "1"
  },

  // Machine-wide grants only. Anything true for just one repo belongs in that
  // repo's .claude/settings.json instead.
  "permissions": {
    "allow": [
      "Bash(npx gsd-core:*)",
      "Read(.planning/**)",
      "Edit(.planning/**)",
      "Read(STATE.md)",
      "Edit(STATE.md)"
    ],
    "deny": [
      "Read(.secrets)",
      "Read(.secrets/**)"
    ],
    "defaultMode": "auto"
  },

  "model": "opus[1m]",
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",

  // ---------------------------------------------------------------------
  // GSD-MANAGED BELOW — installer-owned, do not hand-edit (see note above).
  // Shown abbreviated; the real file wires ~17 hook entries across
  // SessionStart, PreToolUse, PostToolUse, SubagentStop, Stop, PreCompact,
  // and FileChanged. Reinstall GSD to regenerate.
  // ---------------------------------------------------------------------
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "\"<node>\" \"<home>/.claude/hooks/gsd-check-update.js\"" }] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"<node>\" \"<home>/.claude/hooks/gsd-worktree-path-guard.js\"", "timeout": 15 }] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|Edit|Write|MultiEdit|Agent|Task",
        "hooks": [{ "type": "command", "command": "\"<node>\" \"<home>/.claude/hooks/gsd-context-monitor.js\"", "timeout": 15 }] }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"<node>\" \"<home>/.claude/hooks/gsd-statusline.js\""
  },
  // ---------------------------------------------------------------------
  // END GSD-MANAGED
  // ---------------------------------------------------------------------

  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true
  },

  "theme": "dark",
  "tui": "fullscreen"
}

// NOT here, deliberately:
//
//   "worktree": { "baseRef": "head" }
//
// It would WORK here — that is exactly the problem. GSD resolves
// worktree.baseRef first-non-null-wins across three layers:
//
//   1. <repo>/.claude/settings.local.json   gitignored — you only
//   2. <repo>/.claude/settings.json         committed  — everyone  <-- put it here
//   3. ~/.claude/settings.json              this machine — you only
//
// (~/.claude/settings.local.json is NOT a layer and is never read. A value there
// really is inert.)
//
// Setting it here satisfies layer 3, so every repo on THIS machine passes
// `gsd-tools worktree base-check` while a teammate's fresh clone silently drops
// to sequential execution — and it masks repos that are missing the fix, so the
// audit finds nothing. Put it in each repo's committed settings.json and verify
// with `gsd-tools worktree base-check` from inside the repo.
